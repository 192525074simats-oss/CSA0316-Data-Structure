#include <stdio.h>

struct Student
{
    int rollNo;
    char name[50];
    int age;
    char gender[10];
    float marks;
};

int main()
{
    struct Student s;

    printf("Enter Roll Number: ");
    scanf("%d", &s.rollNo);

    printf("Enter Name: ");
    scanf("%s", s.name);

    printf("Enter Age: ");
    scanf("%d", &s.age);

    printf("Enter Gender: ");
    scanf("%s", s.gender);

    printf("Enter Marks: ");
    scanf("%f", &s.marks);

    printf("\n--- Student Details ---\n");
    printf("Roll Number : %d\n", s.rollNo);
    printf("Name        : %s\n", s.name);
    printf("Age         : %d\n", s.age);
    printf("Gender      : %s\n", s.gender);
    printf("Marks       : %.2f\n", s.marks);

    return 0;
}
