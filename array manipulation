#include <stdio.h>

int main()
{
    int arr[10] = {10, 20, 30, 40, 50};
    int n = 5, i;

    // Display Original Array
    printf("Original Array:\n");
    for(i = 0; i < n; i++)
        printf("%d\t ", arr[i]);

    // Insertion
    printf("\n\nAfter Insertion:\n");
    for(i = n; i > 2; i--)
        arr[i] = arr[i - 1];

    arr[2] = 25;
    n++;

    for(i = 0; i < n; i++)
        printf("%d\t ", arr[i]);

    // Deletion
    printf("\n\nAfter Deletion:\n");
    for(i = 2; i < n - 1; i++)
        arr[i] = arr[i + 1];

    n--;

    for(i = 0; i < n; i++)
        printf("%d\t ", arr[i]);

    // Modification
    printf("\n\nAfter Modification:\n");
    arr[1] = 100;

    for(i = 0; i < n; i++)
        printf("%d\t ", arr[i]);

    return 0;
}
